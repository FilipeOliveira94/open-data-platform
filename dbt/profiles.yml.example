# Copy to dbt/profiles.yml (gitignored) or set DBT_PROFILES_DIR.
# Values match the Compose Trino service seen from the runtime image.
open_data_platform:
  target: local
  outputs:
    local:
      type: trino
      method: none
      user: "{{ env_var('TRINO_USER', 'odp') }}"
      # dbt runs in the runtime image on the Compose network (P3-03).
      host: "{{ env_var('ODP_TRINO_HOST', 'trino') }}"
      port: "{{ env_var('ODP_TRINO_PORT', '8080') | int }}"
      database: iceberg
      schema: gold_shared
      threads: 4
      http_scheme: http
      timezone: UTC
