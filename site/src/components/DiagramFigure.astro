---
/**
 * A docs diagram in both site themes. The light and dark PNGs are exports of
 * docs/assets/diagrams/build_diagrams.py; the page imports them from there so
 * docs/ stays the only copy. Wide diagrams scroll inside the figure on a phone
 * instead of shrinking below a readable size.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	light: ImageMetadata;
	dark: ImageMetadata;
	alt: string;
	caption: string;
	source: string;
}

const { light, dark, alt, caption, source } = Astro.props;
const width = Math.round(light.width / 2);
---

<figure class="diagram not-content">
	<div class="diagram__scroll">
		<Image src={light} alt={alt} width={width} class="diagram__light" />
		<Image src={dark} alt={alt} width={width} class="diagram__dark" />
	</div>
	<figcaption>
		{caption} Source: <a href={source}>{source.split('/blob/main/')[1]}</a>.
	</figcaption>
</figure>

<style>
	.diagram {
		margin-block: 1.5rem;
	}
	.diagram__scroll {
		overflow-x: auto;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
	}
	.diagram__scroll img {
		display: block;
		width: 100%;
		min-width: 40rem;
		height: auto;
	}
	/* Show the export that matches the site theme. Starlight's sl-hidden
	   utilities sit in a cascade layer and lose to the display rule above. */
	:global([data-theme='light']) .diagram__dark,
	:global([data-theme='dark']) .diagram__light {
		display: none;
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
