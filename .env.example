# Copy to .env for local overrides. Never commit a real .env file.
# Values below are local-development placeholders only.

# PostgreSQL
POSTGRES_USER=odp
POSTGRES_PASSWORD=odp
POSTGRES_DB=odp
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_SMOKE_BUCKET=odp-smoke
