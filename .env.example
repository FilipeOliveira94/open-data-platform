# Copy to .env for local overrides. Never commit a real .env file.
# Values below are local-development placeholders only.

# PostgreSQL
POSTGRES_USER=odp
POSTGRES_PASSWORD=odp
POSTGRES_DB=odp
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_SMOKE_BUCKET=odp-smoke

# Auditable raw landing zone (MinIO locally / S3 on AWS). See docs/architecture/raw-storage-layout.md
ODP_RAW_BUCKET=odp-raw

# Integration tests write here, never to ODP_RAW_BUCKET (a lakehouse refresh reads that one).
ODP_TEST_RAW_BUCKET=odp-test-raw

# Iceberg warehouse for the P2-01 and P2-02 probes (MinIO locally). Separate from raw landing.
ODP_WAREHOUSE_BUCKET=odp-warehouse

# Database on the Compose PostgreSQL for the Iceberg JDBC catalog (P2-02).
# Separate from POSTGRES_DB. A simple identifier: letters, digits, underscore.
ICEBERG_CATALOG_DB=iceberg

# Trino query engine (lakehouse profile). Inside Compose, Trino is always trino:8080.
# ODP_TRINO_HOST_PORT is the port Compose publishes on the host. Renamed from
# TRINO_PORT in P3-10: a .env that still sets TRINO_PORT falls back to 8080,
# and one that still sets TRINO_USER falls back to odp.
ODP_TRINO_HOST_PORT=8080
# Trino user for the medallion checks and dbt (no password: Trino runs without auth).
ODP_TRINO_USER=odp
# Total seconds for one medallion Trino check query (P3-08).
ODP_TRINO_QUERY_TIMEOUT=600

# Spark local mode inside the runtime image shares the container's CPU and memory
# with Airflow (P3-10). Cores for local[N] and the driver heap (for example 2g, 1536m).
ODP_SPARK_CORES=2
ODP_SPARK_DRIVER_MEMORY=2g

# Days a per-run scratch folder under /opt/odp/work is kept (P3-10).
ODP_WORK_RETENTION_DAYS=7

# Airflow on the Compose orchestration profile (P3-01). Local placeholders only.
# The host port is 8081 because Trino already publishes 8080.
# AIRFLOW_DB is a separate database on the Compose PostgreSQL, same idea as ICEBERG_CATALOG_DB.
# The Fernet key and JWT secret below are local placeholders, same class as POSTGRES_PASSWORD.
AIRFLOW_PORT=8081
AIRFLOW_DB=airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=odp
AIRFLOW_FERNET_KEY=m2MF2P1kdm3qHPyXKJ7j0N5IGxBOswtdV9umW9-n6FA=
AIRFLOW_JWT_SECRET=local-dev-jwt
AIRFLOW_JWT_ISSUER=airflow
# Finished task logs. Distinct from the raw landing zone and the Iceberg warehouse.
ODP_AIRFLOW_LOG_BUCKET=odp-airflow-logs

# Kaggle dataset download. Leave these empty in git. Never commit a real token or key.
# Use KAGGLE_API_TOKEN, or the legacy pair KAGGLE_USERNAME + KAGGLE_KEY.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Local staging for Olist snapshots (gitignored). Relative paths are used as given.
ODP_OLIST_ECOMMERCE_DIR=data/raw/olist_brazilian_ecommerce
ODP_OLIST_FUNNEL_DIR=data/raw/olist_marketing_funnel

# BioGuardia Atlantic synthetic sources (Phase 11, ADR-0027). Not secrets.
# Drops land in ODP_LANDING_BUCKET; the planted-defect lists go to
# ODP_EVALUATION_BUCKET, which the platform's ingestion never reads.
ODP_LANDING_BUCKET=odp-landing
ODP_EVALUATION_BUCKET=odp-evaluation
# Integration tests write drops here, never to ODP_LANDING_BUCKET.
ODP_TEST_LANDING_BUCKET=odp-test-landing
# The world: same seed and scale give the same data. Scale 1 is about 24M rows
# (357 MB gzip, 3.2 GB uncompressed) per daily drop; a drop whose gzip files
# exceed ODP_BIOGUARDIA_MAX_DROP_BYTES fails.
ODP_BIOGUARDIA_SEED=7
ODP_BIOGUARDIA_SCALE=1
ODP_BIOGUARDIA_DEFECTS=default
ODP_BIOGUARDIA_SCHEMA_V2_FROM=2026-12-15
ODP_BIOGUARDIA_HISTORY_START=2026-11-26
ODP_BIOGUARDIA_MAX_DROP_BYTES=2000000000
# Kafka for the telemetry stream (P11-03, profile streaming): host port and retention.
ODP_KAFKA_HOST_PORT=9094
ODP_KAFKA_RETENTION_HOURS=72
# Telemetry (P11-03): cadence divisor for light runs, and the device buffer.
ODP_TELEMETRY_RATE_SCALE=1
ODP_TELEMETRY_BUFFER_HOURS=12
