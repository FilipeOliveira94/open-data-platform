# Copy to .env for local overrides. Never commit a real .env file.
# Values below are local-development placeholders only.

# PostgreSQL
POSTGRES_USER=odp
POSTGRES_PASSWORD=odp
POSTGRES_DB=odp
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_SMOKE_BUCKET=odp-smoke

# Auditable raw landing zone (MinIO locally / S3 on AWS). See docs/architecture/raw-storage-layout.md
ODP_RAW_BUCKET=odp-raw

# Iceberg warehouse for the P2-01 and P2-02 probes (MinIO locally). Separate from raw landing.
ODP_WAREHOUSE_BUCKET=odp-warehouse

# Database on the Compose PostgreSQL for the Iceberg JDBC catalog (P2-02).
# Separate from POSTGRES_DB. A simple identifier: letters, digits, underscore.
ICEBERG_CATALOG_DB=iceberg

# Trino query engine (lakehouse profile). Host port for dbt-trino (P2-06).
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=odp

# Airflow on the Compose orchestration profile (P3-01). Local placeholders only.
# The host port is 8081 because Trino already publishes 8080.
# AIRFLOW_DB is a separate database on the Compose PostgreSQL, same idea as ICEBERG_CATALOG_DB.
# The Fernet key and JWT secret below are local placeholders, same class as POSTGRES_PASSWORD.
AIRFLOW_PORT=8081
AIRFLOW_DB=airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=odp
AIRFLOW_FERNET_KEY=m2MF2P1kdm3qHPyXKJ7j0N5IGxBOswtdV9umW9-n6FA=
AIRFLOW_JWT_SECRET=local-dev-jwt
AIRFLOW_JWT_ISSUER=airflow
# Finished task logs. Distinct from the raw landing zone and the Iceberg warehouse.
ODP_AIRFLOW_LOG_BUCKET=odp-airflow-logs

# Kaggle dataset download. Leave these empty in git. Never commit a real token or key.
# Use KAGGLE_API_TOKEN, or the legacy pair KAGGLE_USERNAME + KAGGLE_KEY.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Local staging for Olist snapshots (gitignored). Relative paths are used as given.
ODP_OLIST_ECOMMERCE_DIR=data/raw/olist_brazilian_ecommerce
ODP_OLIST_FUNNEL_DIR=data/raw/olist_marketing_funnel
