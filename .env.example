# Copy to .env for local overrides. Never commit a real .env file.
# Values below are local-development placeholders only.

# PostgreSQL
POSTGRES_USER=odp
POSTGRES_PASSWORD=odp
POSTGRES_DB=odp
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_SMOKE_BUCKET=odp-smoke

# Auditable raw landing zone (MinIO locally / S3 on AWS). See docs/architecture/raw-storage-layout.md
ODP_RAW_BUCKET=odp-raw

# Kaggle dataset download. Leave these empty in git. Never commit a real token or key.
# Use KAGGLE_API_TOKEN, or the legacy pair KAGGLE_USERNAME + KAGGLE_KEY.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Local staging for Olist snapshots (gitignored). Relative paths are used as given.
ODP_OLIST_ECOMMERCE_DIR=data/raw/olist_brazilian_ecommerce
ODP_OLIST_FUNNEL_DIR=data/raw/olist_marketing_funnel
